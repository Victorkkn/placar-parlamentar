# Copy this file to .env and fill in the values. Never commit .env (decisions 0006 and 0012).

# Django secret key. Generate one with:
#   uv run --directory backend python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Local PostgreSQL in Docker (compose.yaml).
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=

# Summaries (Phase D). Leave empty to use template summaries only.
ANTHROPIC_API_KEY=
SUMMARY_MODEL=

# Optional overrides.
PLACAR_RAW_CACHE_DIR=
PLACAR_CACHE_TTL_HOURS=
PLACAR_REQUESTS_PER_SECOND=
